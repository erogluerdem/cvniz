# Server Configuration
NODE_ENV=production
PORT=3001

# Database
MONGODB_URI=mongodb://mongo:27017/CVniz

# Redis (Cache Layer)
REDIS_URL=redis://redis:6379

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-token-secret
JWT_REFRESH_EXPIRES_IN=30d

# CORS Configuration
CORS_ORIGIN=https://cvniz.com,https://www.cvniz.com,https://admin.cvniz.com,https://api.cvniz.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@cvniz.com

# AWS S3 (for file uploads)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=cvniz-uploads
AWS_S3_REGION=eu-central-1

# Payment Gateway (Iyzipay)
IYZIPAY_API_KEY=your-iyzipay-api-key
IYZIPAY_SECRET_KEY=your-iyzipay-secret-key

# AI Services
OPENAI_API_KEY=your-openai-api-key
GOOGLE_AI_API_KEY=your-google-ai-api-key

# Analytics & Monitoring
SENTRY_DSN=your-sentry-dsn
GOOGLE_ANALYTICS_ID=your-google-analytics-id

# Firebase (Push Notifications)
FIREBASE_CONFIG=your-firebase-config-json

# Application URLs
APP_URL=https://cvniz.com
API_URL=https://api.cvniz.com

# File Upload Configuration
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=pdf,doc,docx,jpg,jpeg,png

# Session Configuration
SESSION_SECRET=your-session-secret
SESSION_TIMEOUT=3600000

# Feature Flags
ENABLE_BETA_FEATURES=false
ENABLE_AI_FEATURES=true

# SMS Configuration (if needed)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Frontend Environment Variables
# .env.production (for web/)
VITE_API_URL=https://api.cvniz.com/api
VITE_APP_URL=https://cvniz.com
VITE_SENTRY_DSN=your-frontend-sentry-dsn
VITE_ENV=production
